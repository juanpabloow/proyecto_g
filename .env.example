# Copia este archivo como .env (en la misma carpeta) y cambia la clave.
# .env está en .gitignore: los secretos nunca se suben al repositorio.
#   cp .env.example .env
#
# Lo leen docker-compose.yml (para crear la base) y la aplicación Spring Boot.
DB_NAME=dac
DB_USER=dac_user
DB_PASSWORD=cambia-esta-clave

# Inicio de sesión del analista (S-10). OBLIGATORIAS: sin ellas la aplicación
# no arranca (salvo con el perfil de desarrollo, java/ejecutar.sh dev, que usa
# la credencial DEMO analista / dac-demo-2026). Cambia la clave.
DAC_AUTH_USER=analista
DAC_AUTH_PASSWORD=cambia-esta-clave

# Grafana (stack opcional de observabilidad, observabilidad/). Usuario admin.
GRAFANA_ADMIN_PASSWORD=cambia-esta-clave
