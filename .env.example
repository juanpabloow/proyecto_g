# Copia este archivo como .env (en la misma carpeta) y cambia la clave.
# .env está en .gitignore: los secretos nunca se suben al repositorio.
#   cp .env.example .env
#
# Lo leen docker-compose.yml (para crear la base) y la aplicación Spring Boot.
DB_NAME=dac
DB_USER=dac_user
DB_PASSWORD=cambia-esta-clave

# Inicio de sesión del analista (S-10). Si no se definen, DAC usa una
# credencial DEMO (analista / dac-demo-2026) para poder evaluarlo sin
# configurar nada. CÁMBIALA antes de desplegar o de cargar datos reales.
DAC_AUTH_USER=analista
DAC_AUTH_PASSWORD=dac-demo-2026
